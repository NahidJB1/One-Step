RewriteCond %{HTTP_HOST} ^(?:www\.)?onestepmy\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?/*[?\s] [NC]
RewriteRule ^index(?:\.html)?/*$ https://www.onestepmy.com/ [R=301,L]

# THE_REQUEST excludes the internal extensionless-to-.html rewrite.
RewriteCond %{HTTP_HOST} ^(?:www\.)?onestepmy\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+[^?\s]*\.html/*[?\s] [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)\.html/*$ https://www.onestepmy.com/$1 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?onestepmy\.com$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/+$ https://www.onestepmy.com/$1 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?onestepmy\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.onestepmy\.com$ [NC]
RewriteRule ^ https://www.onestepmy.com%{REQUEST_URI} [R=301,L,NE]

ErrorDocument 404 /404.html

# Serve only existing extensionless pages after the legacy redirects.
RewriteRule ^(?:index\.html)?$ includes/agent-home.php [END]

RewriteRule ^apply$ apply.php [L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Utility endpoints should remain usable without appearing as search results.
# Allow crawling so search engines can observe the noindex response header.
<FilesMatch "^\.env(?:\..*)?$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  <Files "login.php">
    Header always set X-Robots-Tag "noindex, nofollow"
  </Files>
  <FilesMatch "^(?:admin|logout|submit|submit_application|submit_malaysia_scholarship|debug|original_chat|rewrite_chat2?|test_php|verify_api)\.php$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <FilesMatch "^(?:dev|verify|register)\.html$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <FilesMatch "^(?:404|bot_tester|application)\.html$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>

